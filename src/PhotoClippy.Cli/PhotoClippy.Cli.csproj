<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>photo-clippy</AssemblyName>
    <RootNamespace>PhotoClippy.Cli</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <TieredPGO>true</TieredPGO>
    <!-- A CLI first: no appsettings.json, launch profiles or publish-time web.config. -->
    <IsTransformWebConfigDisabled>true</IsTransformWebConfigDisabled>
    <!-- The SDK only infers this when .razor files exist at restore time. deploy/Dockerfile restores from the
         .csproj files alone, so without it the image ships without _framework/blazor.web.js and the UI stays blank. -->
    <RequiresAspNetWebAssets>true</RequiresAspNetWebAssets>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PhotoClippy.Cli.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../PhotoClippy.Contracts/PhotoClippy.Contracts.csproj" />
    <ProjectReference Include="../PhotoClippy.Core/PhotoClippy.Core.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Metadata/PhotoClippy.Plugins.Metadata.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Auth/PhotoClippy.Plugins.Auth.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Color/PhotoClippy.Plugins.Color.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Composition/PhotoClippy.Plugins.Composition.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.BehavioralFocal/PhotoClippy.Plugins.BehavioralFocal.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Clip/PhotoClippy.Plugins.Clip.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Lenses/PhotoClippy.Plugins.Lenses.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Recommendation/PhotoClippy.Plugins.Recommendation.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.Reporting/PhotoClippy.Plugins.Reporting.csproj" />
    <ProjectReference Include="../PhotoClippy.Plugins.External/PhotoClippy.Plugins.External.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Spectre.Console" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../data/**/*" LinkBase="data" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
