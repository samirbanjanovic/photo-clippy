# Copy to .env next to docker-compose.yaml and adjust. Docker Compose reads it automatically.

# Required: the photo library on the host, mounted read-only at /photos.
CLIPPY_LIBRARY=/path/to/photos

# Where state is kept: a named volume by default, or a host folder writable by PUID:PGID.
# CLIPPY_DATA=/srv/photo-clippy
# PUID=1000
# PGID=1000

# Host port for the web UI.
# CLIPPY_PORT=8080
# TZ=Europe/Oslo

# Run a pre-built image (for example one pushed by publish-image.sh) instead of building locally.
# CLIPPY_IMAGE=registry.example.lan/photo-clippy:latest
# CLIPPY_PULL_POLICY=always

# Behind Traefik: add the override file and name the route.
# COMPOSE_FILE=docker-compose.yaml:docker-compose.traefik.yaml
# CLIPPY_HOST=photos.example.lan
# TRAEFIK_NETWORK=traefik
# TRAEFIK_ENTRYPOINT=websecure
